#: wc-victoriabank.php:500
#, php-format
msgid "%1$s field must be set."
msgstr "В поле %1$s должно быть задано значение."

#. translators: 1: Plugin settings URL
#: wc-victoriabank.php:540
#, php-format
msgid ""
"Please review the <a href=\"%1$s\">payment method settings</a> page for log "
"details and setup instructions."
msgstr ""
"Перейдите на страницу <a href=\"%1$s\">настройки платежного шлюза</a> для "
"просмотра сведений журнала и инструкций по установке."

