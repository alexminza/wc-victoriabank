msgid "Public key"
msgstr "Cheie publică"

#: wc-victoriabank.php:305
msgid "Bank public key"
msgstr "Cheie publică bancă"

#: wc-victoriabank.php:313
msgid "Private key"
msgstr "Cheie privată"

#: wc-victoriabank.php:322 wc-victoriabank.php:534
msgid "Public key file"
msgstr "Fișier cheie publică"

#: wc-victoriabank.php:327 wc-victoriabank.php:540
msgid "Bank public key file"
msgstr "Fișier cheie publică bancă"

#: wc-victoriabank.php:332 wc-victoriabank.php:546
msgid "Private key file"
msgstr "Fișier cheie privată"

#: wc-victoriabank.php:337
msgid "Private key passphrase"
msgstr "Parolă cheie privată"

#: wc-victoriabank.php:339
msgid "Leave empty if private key is not encrypted."
msgstr "Lăsați vid dacă cheia privată nu este criptată."

#: wc-victoriabank.php:341
msgid "Optional"
msgstr "Opțional"

#: wc-victoriabank.php:345
msgid "Payment Notification"
msgstr "Notificare plăți"

#: wc-victoriabank.php:349
msgid "Provide this URL to the bank to enable online payment notifications."
msgstr ""
"Furnizați băncii această adresă URL pentru activare notificări de plată "
"online."

#: wc-victoriabank.php:350
msgid "Callback URL"
msgstr "URL apel invers (Callback URL)"

#: wc-victoriabank.php:352
msgid "Advanced&raquo;"
msgstr "Opțiuni avansate&raquo;"

#: wc-victoriabank.php:356
msgid "Process callback data"
msgstr "Procesează date apel invers"

#: wc-victoriabank.php:359
msgid ""
"Manually process bank transaction response callback data received by email "
"as part of the backup procedure."
msgstr ""
"Procesează manual datele de răspuns apel invers tranzacție primite prin "
"email de la bancă ca parte a procedurii de siguranță."

#: wc-victoriabank.php:451
msgid ""
"Are you sure you want to process the entered bank transaction response "
"callback data?"
msgstr ""
"Sigur vrei să procesezi datele introduse răspuns apel invers tranzacție de "
"la bancă?"

#: wc-victoriabank.php:516
msgid "Unsupported store currency"
msgstr "Valuta magazinului nu este suportată"

#: wc-victoriabank.php:518
msgid "Supported currencies"
msgstr "Valute suportate"

#. translators: 1: Plugin installation instructions URL
#: wc-victoriabank.php:528
#, php-format
msgid ""
"See plugin documentation for <a href=\"%1$s\" target=\"_blank\">installation "
"instructions</a>."
msgstr ""
"Consultați documentația modulului pentru <a href=\"%1$s\" "
"target=\"_blank\">instrucțiuni de instalare</a>."

#: wc-victoriabank.php:529
msgid "Not configured"
msgstr "Neconfigurat"

#: wc-victoriabank.php:552
msgid ""
"Current server settings do not allow web requests to the bank payment "
"gateway. See <a href=\"https://www.php.net/manual/en/"
"filesystem.configuration.php#ini.allow-url-fopen\" target=\"_blank\">PHP "
"Runtime Configuration</a> for details."
msgstr ""
"Setările curente ale serverului nu permit apeluri web către serverele "
"băncii. Vezi <a href=\"https://www.php.net/manual/en/"
"filesystem.configuration.php#ini.allow-url-fopen\" target=\"_blank\">PHP "
"Runtime Configuration</a> pentru mai multe detalii."

#. translators: 1: Plugin settings URL
#: wc-victoriabank.php:563
#, php-format
msgid ""
"Please review the <a href=\"%1$s\">payment method settings</a> page for log "
