msgid "Merchant address"
msgstr "Adresă comerciant"

#: wc-victoriabank.php:266
msgid "Merchant ID"
msgstr "ID comerciant"

#: wc-victoriabank.php:268
msgid "Example: 498000049812345"
msgstr "Exemplu: 498000049812345"

#: wc-victoriabank.php:276
msgid "Terminal ID"
msgstr "ID terminal"

#: wc-victoriabank.php:278
msgid "Example: 49812345"
msgstr "Exemplu: 49812345"

#: wc-victoriabank.php:287 wc-victoriabank.php:529
msgid "Connection Settings"
msgstr "Setări conexiune"

#: wc-victoriabank.php:291
msgid ""
"Use Basic settings to upload the key files received from the bank or "
"configure manually using Advanced settings below."
msgstr ""
"Utilizați Setările de bază pentru a încărca fișierele cu chei primite de la "
"bancă sau configurați manual utilizând Setările avansate de mai jos."

#: wc-victoriabank.php:292
msgid "Basic settings&raquo;"
msgstr "Setări de bază&raquo;"

#: wc-victoriabank.php:293
msgid "Advanced settings&raquo;"
msgstr "Setări avansate&raquo;"

