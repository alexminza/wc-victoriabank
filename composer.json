{
    "name": "alexminza/wc-victoriabank",
    "description": "Payment Gateway for Victoriabank for WooCommerce",
    "type": "wordpress-plugin",
    "keywords": [
        "WooCommerce",
        "Moldova",
        "Victoriabank",
        "bank",
        "payment",
        "gateway",
        "visa",
        "mastercard"
    ],
    "homepage": "https://github.com/alexminza/wc-victoriabank",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Alexander Minza",
            "homepage": "https://www.alexminza.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/alexminza/wc-victoriabank/issues",
        "forum": "https://wordpress.org/support/plugin/wc-victoriabank",
        "source": "https://github.com/alexminza/wc-victoriabank"
    },
    "require": {
        "php": ">=7.2.5",
        "alexminza/victoriabank-sdk": "^1.0",
        "alexminza/wc-payment-gateway-base": "^1.0",
        "monolog/monolog": "^2.7"
    },
    "config": {
        "platform": {
            "php": "7.2.5"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "prefer-stable": true,
    "require-dev": {
        "woocommerce/woocommerce-sniffs": "^1.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../victoriabank-sdk-php",
            "options": {
                "symlink": false
            }
        },
        {
            "type": "path",
            "url": "../wc-payment-gateway-base",
            "options": {
                "symlink": false
            }
        }
    ],
    "minimum-stability": "dev"
}
